<aside class="chat-widget" aria-label="Resume assistant">
  <section class="chat-panel" id="resume-chat-panel" aria-labelledby="chat-title" hidden>
    <header class="chat-header">
      <div>
        <p class="chat-kicker">XIMO LIANG / PORTFOLIO</p>
        <h2 id="chat-title">Ask about my work</h2>
      </div>
      <button class="chat-close" type="button" aria-label="Close chat">×</button>
    </header>
    <div class="chat-messages" role="log" aria-live="polite" aria-relevant="additions text">
      <p class="chat-welcome">Hi — ask me about Ximo’s experience, projects, skills, or research.</p>
    </div>
    <form class="chat-form">
      <label class="visually-hidden" for="chat-input">Your question</label>
      <textarea id="chat-input" name="message" rows="2" maxlength="1000" placeholder="Ask a question…" required></textarea>
      <div class="chat-form-footer">
        <span class="chat-hint">Answers are based on the résumé.</span>
        <button class="chat-send" type="submit">Send <span aria-hidden="true">↗</span></button>
      </div>
    </form>
  </section>
  <button class="chat-launcher" type="button" aria-expanded="false" aria-controls="resume-chat-panel">
    <span class="launcher-dot" aria-hidden="true"></span>
    <span>Ask about my work</span>
  </button>
</aside>

<script>
  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const endpoint = import.meta.env.PUBLIC_CHATBOT_API_URL || (import.meta.env.DEV ? 'http://localhost:8787' : '');
  const launcher = document.querySelector<HTMLButtonElement>('.chat-launcher');
  const panel = document.querySelector<HTMLElement>('#resume-chat-panel');
  const closeButton = document.querySelector<HTMLButtonElement>('.chat-close');
  const form = document.querySelector<HTMLFormElement>('.chat-form');
  const input = document.querySelector<HTMLTextAreaElement>('#chat-input');
  const messagesEl = document.querySelector<HTMLElement>('.chat-messages');
  const sendButton = document.querySelector<HTMLButtonElement>('.chat-send');
  const messages: ChatMessage[] = [];

  function setOpen(open: boolean) {
    if (!panel || !launcher) return;
    panel.hidden = !open;
    launcher.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
    else launcher.focus();
  }

  function addMessage(role: ChatMessage['role'], text: string) {
    if (!messagesEl) return null;
    const element = document.createElement('p');
    element.className = `chat-message ${role}`;
    element.textContent = text;
    messagesEl.append(element);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return element;
  }

  launcher?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  closeButton?.addEventListener('click', () => setOpen(false));

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const question = input?.value.trim();
    if (!question || !input || !sendButton) return;

    if (!endpoint) {
      addMessage('assistant', 'Chat is not configured on this deployment yet. Please try again later.');
      return;
    }

    // Preserve complete user/assistant turns and stay within the Worker request cap.
    while (messages.length >= 20) messages.splice(0, 2);
    messages.push({ role: 'user', content: question });
    addMessage('user', question);
    input.value = '';
    input.disabled = true;
    sendButton.disabled = true;
    sendButton.textContent = 'Thinking…';
    const answer = addMessage('assistant', '');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: messages.slice(-20) }),
      });
      if (!response.ok) {
        let detail = '';
        try {
          const data = (await response.json()) as { error?: string };
          detail = data?.error ?? '';
        } catch {
          // Ignore non-JSON error bodies.
        }
        throw new Error(detail || `Chat request failed (${response.status})`);
      }
      if (!response.body) throw new Error('Chat request failed (no response body)');

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let text = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        text += decoder.decode(value, { stream: true });
        if (answer) answer.textContent = text;
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
      }
      text += decoder.decode();
      if (!text.trim()) throw new Error('The assistant returned an empty response.');
      messages.push({ role: 'assistant', content: text });
    } catch (error) {
      const raw = error instanceof Error ? error.message : '';
      let message: string;
      if (raw.includes('fetch') || raw.includes('Failed to fetch') || raw.includes('NetworkError')) {
        message = 'Could not reach the chat service. Check that the Worker is deployed and try again.';
      } else if (raw && !raw.startsWith('Chat request failed')) {
        // Surface the Worker's specific error (e.g. model temporarily unavailable).
        message = raw;
      } else {
        message = 'Sorry, the assistant could not answer right now. Please try again.';
      }
      if (answer) answer.textContent = message;
      else addMessage('assistant', message);
      messages.pop();
    } finally {
      input.disabled = false;
      sendButton.disabled = false;
      sendButton.innerHTML = 'Send <span aria-hidden="true">↗</span>';
      input.focus();
    }
  });
</script>

<style>
  .chat-widget {
    position: fixed;
    z-index: 80;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    font-family: 'Aptos', 'Segoe UI', system-ui, sans-serif;
  }
  .chat-launcher,
  .chat-send {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    cursor: pointer;
  }
  .chat-launcher {
    padding: 0.65rem 1rem;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }
  .chat-launcher:hover,
  .chat-send:hover:not(:disabled) {
    background: #e0f59a;
  }
  .launcher-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #37451d;
  }
  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.8rem);
    display: flex;
    width: min(390px, calc(100vw - 2rem));
    max-height: min(560px, calc(100dvh - 7rem));
    flex-direction: column;
    border: 1px solid var(--border);
    background: #141914;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.48);
  }
  .chat-panel[hidden] {
    display: none;
  }
  .chat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .chat-kicker {
    margin: 0 0 0.3rem;
    color: var(--accent);
    font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
    font-size: 0.57rem;
    letter-spacing: 0.1em;
  }
  .chat-header h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 400;
  }
  .chat-close {
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }
  .chat-messages {
    display: flex;
    min-height: 140px;
    flex: 1;
    flex-direction: column;
    gap: 0.65rem;
    overflow-y: auto;
    padding: 1rem;
  }
  .chat-welcome,
  .chat-message {
    max-width: 90%;
    margin: 0;
    padding: 0.65rem 0.75rem;
    color: var(--text-dim);
    font-size: 0.82rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .chat-welcome,
  .chat-message.assistant {
    align-self: flex-start;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .chat-message.user {
    align-self: flex-end;
    background: #252d20;
    color: var(--text);
  }
  .chat-form {
    padding: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .chat-form textarea {
    display: block;
    width: 100%;
    min-height: 54px;
    resize: vertical;
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 0.65rem;
    background: #101310;
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
  }
  .chat-form textarea::placeholder {
    color: var(--text-faint);
  }
  .chat-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-top: 0.6rem;
  }
  .chat-hint {
    color: var(--text-faint);
    font-size: 0.65rem;
  }
  .chat-send {
    min-height: 35px;
    padding: 0.35rem 0.7rem;
    font-size: 0.75rem;
  }
  .chat-send:disabled,
  .chat-form textarea:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
  @media (max-width: 480px) {
    .chat-widget {
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
    .chat-panel {
      position: fixed;
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: calc(max(0.75rem, env(safe-area-inset-bottom)) + 3.5rem);
      width: calc(100vw - 1.5rem);
      max-height: min(70dvh, 560px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-launcher,
    .chat-send {
      transition: none;
    }
  }
</style>
