<aside class="chat-widget" aria-label="Resume assistant">
  <section class="chat-panel" id="resume-chat-panel" aria-labelledby="chat-title" role="dialog" aria-modal="true" hidden>
    <div class="chat-shell">
      <header class="chat-header">
        <div class="chat-brand">
          <img class="brand-mark" src="/favicon.svg" alt="" aria-hidden="true" />
          <div>
            <p class="chat-kicker">PORTFOLIO ASSISTANT <span class="status-dot" aria-hidden="true"></span></p>
            <h2 id="chat-title">Ask AI about me</h2>
          </div>
        </div>
        <div class="chat-controls">
          <button class="chat-close" type="button" aria-label="Close chat" title="Close chat">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
          </button>
        </div>
      </header>
      <main class="chat-messages" role="log" aria-live="polite" aria-relevant="additions text">
        <div class="chat-welcome">
          <span class="welcome-eyebrow">GET TO KNOW XIMO</span>
          <p>Hi — ask me about my experience, projects, skills, or research.</p>
          <div class="suggestions" aria-label="Suggested questions">
            <button type="button" class="suggestion">What projects has Ximo worked on?</button>
            <button type="button" class="suggestion">What are his core skills?</button>
          </div>
        </div>
      </main>
      <form class="chat-form">
        <label class="visually-hidden" for="chat-input">Your question</label>
        <div class="composer">
          <textarea id="chat-input" name="message" rows="2" maxlength="1000" placeholder="Ask anything about Ximo’s work…" required></textarea>
          <button class="chat-send" type="submit" aria-label="Send message" title="Send message">
            <svg class="send-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5" /></svg>
          </button>
        </div>
        <div class="chat-form-footer">
          <span class="chat-hint">Answers are grounded in the resume <span aria-hidden="true">·</span> Enter to send, Shift + Enter for a new line</span>

        </div>
      </form>
    </div>
  </section>
  <button class="chat-launcher" type="button" aria-expanded="false" aria-controls="resume-chat-panel">
    <span class="launcher-dot" aria-hidden="true"></span>
    <span>Ask AI about me</span>
    <span class="launcher-arrow" aria-hidden="true">↗</span>
  </button>
</aside>

<script>
  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const endpoint = import.meta.env.PUBLIC_CHATBOT_API_URL || (import.meta.env.DEV ? 'http://localhost:8787' : '');
  const launcher = document.querySelector<HTMLButtonElement>('.chat-launcher');
  const panel = document.querySelector<HTMLElement>('#resume-chat-panel');
  const closeButton = document.querySelector<HTMLButtonElement>('.chat-close');
  const form = document.querySelector<HTMLFormElement>('.chat-form');
  const input = document.querySelector<HTMLTextAreaElement>('#chat-input');
  const messagesEl = document.querySelector<HTMLElement>('.chat-messages');
  const welcome = document.querySelector<HTMLElement>('.chat-welcome');
  const sendButton = document.querySelector<HTMLButtonElement>('.chat-send');
  const messages: ChatMessage[] = [];

  function setOpen(open: boolean) {
    if (!panel || !launcher) return;
    panel.hidden = !open;
    launcher.hidden = open;
    launcher.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
    else launcher.focus();
  }

  function appendInlineMarkdown(parent: HTMLElement, source: string) {
    const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+|mailto:[^\s)]+)\)|`([^`]+)`|\*\*([^*]+)\*\*|__([^_]+)__|\*([^*\n]+)\*|_([^_\n]+)_/g;
    let cursor = 0;
    for (const match of source.matchAll(pattern)) {
      const index = match.index ?? 0;
      if (index > cursor) parent.append(document.createTextNode(source.slice(cursor, index)));
      if (match[1] && match[2]) {
        const link = document.createElement('a');
        link.textContent = match[1];
        link.href = match[2];
        link.rel = 'noopener noreferrer';
        link.target = '_blank';
        parent.append(link);
      } else if (match[3]) {
        const code = document.createElement('code');
        code.textContent = match[3];
        parent.append(code);
      } else if (match[4] || match[5]) {
        const strong = document.createElement('strong');
        strong.textContent = match[4] ?? match[5] ?? '';
        parent.append(strong);
      } else if (match[6] || match[7]) {
        const emphasis = document.createElement('em');
        emphasis.textContent = match[6] ?? match[7] ?? '';
        parent.append(emphasis);
      }
      cursor = index + match[0].length;
    }
    if (cursor < source.length) parent.append(document.createTextNode(source.slice(cursor)));
  }

  function renderMarkdown(element: HTMLElement, markdown: string) {
    element.replaceChildren();
    const lines = markdown.replace(/\r\n?/g, '\n').split('\n');
    let paragraph: string[] = [];
    let list: HTMLOListElement | HTMLUListElement | null = null;
    let codeLines: string[] | null = null;

    const flushParagraph = () => {
      if (!paragraph.length) return;
      const node = document.createElement('p');
      paragraph.forEach((line, index) => {
        if (index) node.append(document.createElement('br'));
        appendInlineMarkdown(node, line);
      });
      element.append(node);
      paragraph = [];
    };
    const closeList = () => {
      list = null;
    };

    for (const line of lines) {
      if (codeLines) {
        if (/^\s*```/.test(line)) {
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = codeLines.join('\n');
          pre.append(code);
          element.append(pre);
          codeLines = null;
        } else {
          codeLines.push(line);
        }
        continue;
      }
      if (/^\s*```/.test(line)) {
        flushParagraph();
        closeList();
        codeLines = [];
        continue;
      }
      if (!line.trim()) {
        flushParagraph();
        closeList();
        continue;
      }
      const heading = /^(#{1,3})\s+(.+)$/.exec(line);
      if (heading) {
        flushParagraph();
        closeList();
        const node = document.createElement(`h${heading[1].length}`);
        appendInlineMarkdown(node, heading[2]);
        element.append(node);
        continue;
      }
      if (/^\s*[-*_]{3,}\s*$/.test(line)) {
        flushParagraph();
        closeList();
        element.append(document.createElement('hr'));
        continue;
      }
      const unordered = /^\s*[-*+]\s+(.+)$/.exec(line);
      const ordered = /^\s*\d+[.)]\s+(.+)$/.exec(line);
      if (unordered || ordered) {
        flushParagraph();
        const isOrdered = Boolean(ordered);
        if (!list || (isOrdered !== (list.tagName === 'OL'))) {
          closeList();
          list = document.createElement(isOrdered ? 'ol' : 'ul');
          element.append(list);
        }
        const item = document.createElement('li');
        appendInlineMarkdown(item, (unordered ?? ordered)?.[1] ?? '');
        list.append(item);
        continue;
      }
      const quote = /^\s*>\s?(.*)$/.exec(line);
      if (quote) {
        flushParagraph();
        closeList();
        const blockquote = document.createElement('blockquote');
        appendInlineMarkdown(blockquote, quote[1]);
        element.append(blockquote);
        continue;
      }
      closeList();
      paragraph.push(line);
    }
    if (codeLines) {
      const pre = document.createElement('pre');
      const code = document.createElement('code');
      code.textContent = codeLines.join('\n');
      pre.append(code);
      element.append(pre);
    }
    flushParagraph();
  }

  function addMessage(role: ChatMessage['role'], text: string) {
    if (!messagesEl) return null;
    const element = document.createElement('div');
    element.className = `chat-message ${role}`;
    if (role === 'assistant' && text) renderMarkdown(element, text);
    else element.textContent = text;
    messagesEl.append(element);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return element;
  }

  launcher?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  closeButton?.addEventListener('click', () => setOpen(false));

  document.querySelectorAll<HTMLButtonElement>('.suggestion').forEach((button) => {
    button.addEventListener('click', () => {
      if (!input || !form) return;
      input.value = button.textContent ?? '';
      form.requestSubmit();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const question = input?.value.trim();
    if (!question || !input || !sendButton) return;

    if (!endpoint) {
      addMessage('assistant', 'Chat is not configured on this deployment yet. Please try again later.');
      return;
    }

    // Preserve complete user/assistant turns and stay within the Worker request cap.
    while (messages.length >= 20) messages.splice(0, 2);
    welcome?.remove();
    messages.push({ role: 'user', content: question });
    addMessage('user', question);
    input.value = '';
    input.disabled = true;
    sendButton.disabled = true;
    sendButton.classList.add('is-sending');
    sendButton.setAttribute('aria-label', 'Sending message');
    const answer = addMessage('assistant', '');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: messages.slice(-20) }),
      });
      if (!response.ok) {
        let detail = '';
        try {
          const data = (await response.json()) as { error?: string };
          detail = data?.error ?? '';
        } catch {
          // Ignore non-JSON error bodies.
        }
        throw new Error(detail || `Chat request failed (${response.status})`);
      }
      if (!response.body) throw new Error('Chat request failed (no response body)');

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let text = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        text += decoder.decode(value, { stream: true });
        if (answer) renderMarkdown(answer, text);
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
      }
      text += decoder.decode();
      if (!text.trim()) throw new Error('The assistant returned an empty response.');
      messages.push({ role: 'assistant', content: text });
    } catch (error) {
      const raw = error instanceof Error ? error.message : '';
      let message: string;
      if (raw.includes('fetch') || raw.includes('Failed to fetch') || raw.includes('NetworkError')) {
        message = 'Could not reach the chat service. Check that the Worker is deployed and try again.';
      } else if (raw && !raw.startsWith('Chat request failed')) {
        // Surface the Worker's specific error (e.g. model temporarily unavailable).
        message = raw;
      } else {
        message = 'Sorry, the assistant could not answer right now. Please try again.';
      }
      if (answer) answer.textContent = message;
      else addMessage('assistant', message);
      messages.pop();
    } finally {
      input.disabled = false;
      sendButton.disabled = false;
      sendButton.classList.remove('is-sending');
      sendButton.setAttribute('aria-label', 'Send message');
      input.focus();
    }
  });
</script>

