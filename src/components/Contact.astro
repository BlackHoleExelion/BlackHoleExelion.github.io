---
import { profile } from '../data/resume';
---

<section id="contact">
  <div class="contact-panel">
    <div class="contact-copy">
      <span class="section-index">05 / Next steps</span>
      <h2 class="section-title">Let’s make<br /><em>good work.</em></h2>
      <p class="section-sub">Open to thoughtful conversations about data science and data engineering opportunities.</p>
      <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="contact-links">
      <a href={profile.linkedin} target="_blank" rel="noopener"><span>01</span>LinkedIn<span aria-hidden="true">↗</span></a>
      <a href={`${import.meta.env.BASE_URL}/${profile.resumePdf}`} download><span>02</span>Download my resume<span aria-hidden="true">↓</span></a>
      <div class="availability"><span></span>BASED IN {profile.location.toUpperCase()}</div>
    </div>
  </div>
  <footer class="site-footer">
    <a href="#top">{profile.name}<span aria-hidden="true"> ↑</span></a>
    <span>© {new Date().getFullYear()} · BUILT WITH CARE</span>
    <span>DATA · SYSTEMS · RESEARCH</span>
  </footer>
</section>

<style>
  #contact {
    padding-bottom: 2rem;
  }
  .contact-panel {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 1px solid var(--border);
    background: linear-gradient(115deg, #1b211b, #141914 70%);
  }
  .contact-copy .section-title {
    margin: 1rem 0;
    font-size: clamp(3rem, 6vw, 5rem);
  }
  .contact-copy .section-title em {
    color: var(--accent);
    font-weight: 400;
  }
  .contact-copy .section-sub {
    max-width: 430px;
    margin-bottom: 1.7rem;
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--accent);
    color: var(--text);
    font-size: 0.95rem;
  }
  .contact-email span {
    color: var(--accent);
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .contact-links > a {
    display: grid;
    grid-template-columns: 36px 1fr 20px;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .contact-links > a:first-child {
    border-top: 1px solid var(--border);
  }
  .contact-links > a span:first-child {
    color: var(--text-faint);
    font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
    font-size: 0.65rem;
  }
  .contact-links > a span:last-child {
    color: var(--accent);
  }
  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.4rem;
    color: var(--text-faint);
    font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.07em;
  }
  .availability span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
    padding: 1rem 0;
    color: var(--text-faint);
    font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
    font-size: 0.57rem;
    letter-spacing: 0.07em;
  }
  .site-footer a {
    color: var(--text-dim);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.8rem;
    letter-spacing: 0;
  }
  .site-footer a span {
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .contact-panel {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .site-footer {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 480px) {
    .site-footer span:last-child {
      display: none;
    }
  }
</style>
