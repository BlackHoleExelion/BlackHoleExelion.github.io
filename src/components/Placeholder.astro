---
interface Props {
  kind: 'mockup' | 'diagram' | 'demo';
  visual: string;
  label: string;
}

const { kind, visual, label } = Astro.props;
---

<div class:list={['placeholder', kind]} role="img" aria-label={`Illustrative overview for ${label}`}>
  <div class="ph-art" aria-hidden="true">
    {visual === 'map' && (
      <svg viewBox="0 0 480 180" fill="none">
        <g stroke="#8faaa0" stroke-opacity=".24"><path d="M0 45H480M0 90H480M0 135H480M60 0V180M120 0V180M180 0V180M240 0V180M300 0V180M360 0V180M420 0V180"/></g>
        <g fill="#d2ed78" fill-opacity=".18" stroke="#d2ed78" stroke-opacity=".72" stroke-width="1.3">
          <path d="M154 43L174 32L194 43V65L174 76L154 65Z"/><path d="M194 43L214 32L234 43V65L214 76L194 65Z"/><path d="M174 76L194 65L214 76V98L194 109L174 98Z"/><path d="M214 76L234 65L254 76V98L234 109L214 98Z"/><path d="M234 109L254 98L274 109V131L254 142L234 131Z"/>
        </g>
        <path d="M75 128C111 124 124 89 158 89S204 120 237 90 297 47 334 68 385 110 427 43" stroke="#d6a778" stroke-width="1.5" stroke-dasharray="4 5"/>
        <g fill="#d6a778"><circle cx="75" cy="128" r="3"/><circle cx="237" cy="90" r="3"/><circle cx="427" cy="43" r="3"/></g>
      </svg>
    )}
    {visual === 'agent' && (
      <svg viewBox="0 0 480 220" fill="none">
        <text x="18" y="22" fill="#a4aaa0" font-family="monospace" font-size="8" letter-spacing="1">MCP TRADING AGENT / ORCHESTRATION</text>
        <text x="374" y="22" fill="#d2ed78" font-family="monospace" font-size="8">10 MIN CYCLE</text>

        <g transform="translate(-12 -3) scale(1.05)">
        <rect x="25" y="49" width="112" height="96" fill="#171c18" stroke="#465144"/>
        <text x="37" y="65" fill="#d2ed78" font-family="monospace" font-size="7" letter-spacing=".6">MARKET CONTEXT</text>
        <path d="M37 72H125" stroke="#465144"/>
        <g fill="#a4aaa0" font-family="monospace" font-size="7"><text x="38" y="86">PRICE & VOLUME</text><text x="38" y="101">FUNDAMENTALS</text><text x="38" y="116">SENTIMENT / NEWS</text></g>
        <path d="M38 130H91" stroke="#8faaa0" stroke-opacity=".45"/><text x="96" y="133" fill="#727a70" font-family="monospace" font-size="6">COMPACT</text>

        <rect x="166" y="55" width="145" height="84" fill="#20291e" stroke="#d2ed78"/>
        <text x="180" y="74" fill="#a4aaa0" font-family="monospace" font-size="7" letter-spacing=".7">MODEL / DEEPSEEK V3.2</text>
        <text x="180" y="96" fill="#f0efe8" font-family="monospace" font-size="10">PLAN → CALL → REVIEW</text>
        <path d="M180 106H297" stroke="#465144"/>
        <text x="180" y="124" fill="#d2ed78" font-family="monospace" font-size="7">MULTI-ROUND TOOL USE</text>

        <rect x="340" y="49" width="115" height="96" fill="#171c18" stroke="#465144"/>
        <text x="352" y="65" fill="#d2ed78" font-family="monospace" font-size="7" letter-spacing=".6">3 MCP SERVERS</text>
        <path d="M352 72H443" stroke="#465144"/>
        <g fill="#a4aaa0" font-family="monospace" font-size="7"><text x="353" y="86">01 / EXECUTION</text><text x="353" y="101">02 / MARKET DATA</text><text x="353" y="116">03 / WEB & RESEARCH</text></g>
        <text x="353" y="134" fill="#727a70" font-family="monospace" font-size="6">40+ ROUTED TOOLS</text>

        <path d="M137 97H166M311 97H340" stroke="#8faaa0" stroke-width="1.2"/>
        <path d="M153 94L159 97L153 100M326 94L332 97L326 100" stroke="#d2ed78"/>
        <path d="M397 151V161H239V151" stroke="#8faaa0" stroke-opacity=".5" stroke-dasharray="3 4"/>
        <path d="M239 161H83V151" stroke="#8faaa0" stroke-opacity=".5" stroke-dasharray="3 4"/>

        <g><rect x="25" y="171" width="125" height="23" fill="#171c18" stroke="#465144"/><rect x="177" y="171" width="125" height="23" fill="#171c18" stroke="#465144"/><rect x="329" y="171" width="126" height="23" fill="#171c18" stroke="#465144"/></g>
        <g fill="#d2ed78" font-family="monospace" font-size="7"><text x="37" y="186">PRE-TRADE VALIDATION</text><text x="190" y="186">RISK / CIRCUIT BREAKERS</text><text x="341" y="186">STRUCTURED JSON AUDIT</text></g>
        <g fill="#727a70" font-family="monospace" font-size="6"><text x="25" y="204">31+ REUSABLE TOOLS</text><text x="366" y="204">~60% FEWER TOOL ITERATIONS</text></g>
        </g>
      </svg>
    )}
    {visual === 'search' && (
      <svg viewBox="0 0 480 180" fill="none">
        <rect x="32" y="20" width="416" height="32" fill="#171c18" stroke="#465144"/><circle cx="49" cy="36" r="5" stroke="#d2ed78"/><path d="M53 40L58 45" stroke="#d2ed78"/><text x="70" y="40" fill="#a4aaa0" font-family="monospace" font-size="9">QUERY: semantic + lexical retrieval</text>
        <g><rect x="32" y="68" width="190" height="40" fill="#171c18" stroke="#465144"/><rect x="32" y="118" width="190" height="40" fill="#171c18" stroke="#465144"/><rect x="258" y="68" width="190" height="40" fill="#171c18" stroke="#465144"/><rect x="258" y="118" width="190" height="40" fill="#171c18" stroke="#465144"/></g>
        <g fill="#d2ed78" font-family="monospace" font-size="9"><text x="45" y="86">LEXICAL SCORE</text><text x="45" y="136">VECTOR SCORE</text><text x="272" y="86">RANK FUSION</text><text x="272" y="136">RESULT INDEX</text></g>
        <g fill="#8faaa0"><rect x="45" y="94" width="145" height="3"/><rect x="45" y="144" width="110" height="3"/><rect x="272" y="94" width="121" height="3"/><rect x="272" y="144" width="151" height="3"/></g>
        <path d="M222 88H258M222 138H258" stroke="#8faaa0" stroke-dasharray="3 4"/>
      </svg>
    )}
    {visual === 'chat' && (
      <svg viewBox="0 0 480 220" fill="none">
        <text x="18" y="22" fill="#a4aaa0" font-family="monospace" font-size="8" letter-spacing="1">EXPERTISE ASSISTANT</text>
        <text x="408" y="22" fill="#d2ed78" font-family="monospace" font-size="8">● LIVE</text>

        <g transform="translate(-12 -5) scale(1.05)">
        <rect x="27" y="49" width="260" height="113" fill="#171c18" stroke="#303830"/>
        <text x="39" y="65" fill="#727a70" font-family="monospace" font-size="7" letter-spacing=".7">ASK ABOUT PROJECTS OR EXPERIENCE</text>
        <rect x="39" y="73" width="223" height="25" fill="#20291e" stroke="#465144"/>
        <text x="49" y="89" fill="#a4aaa0" font-family="monospace" font-size="8">How was the search platform built?</text>
        <rect x="52" y="106" width="223" height="43" fill="#1c221d" stroke="#d2ed78" stroke-opacity=".55"/>
        <text x="62" y="119" fill="#d2ed78" font-family="monospace" font-size="7" letter-spacing=".4">RETRIEVED PROJECT CONTEXT</text>
        <path d="M62 128H255M62 137H233" stroke="#8faaa0" stroke-opacity=".55"/>
        <circle cx="64" cy="155" r="2" fill="#d2ed78"/><text x="71" y="158" fill="#a4aaa0" font-family="monospace" font-size="7">Grounded answer · project details</text>

        <rect x="298" y="49" width="155" height="113" fill="#171c18" stroke="#303830"/>
        <text x="310" y="65" fill="#a4aaa0" font-family="monospace" font-size="7" letter-spacing=".7">SESSION OVERVIEW</text>
        <text x="310" y="91" fill="#f0efe8" font-family="monospace" font-size="17">1,284</text>
        <text x="369" y="90" fill="#727a70" font-family="monospace" font-size="7">SESSIONS</text>
        <path d="M310 137L327 128L341 132L355 109L371 117L388 96L405 103L421 78L439 86" stroke="#d2ed78" stroke-width="1.5"/>
        <path d="M310 144H439M310 118H439M310 92H439" stroke="#8faaa0" stroke-opacity=".15"/>
        <g fill="#d2ed78"><circle cx="355" cy="109" r="2"/><circle cx="421" cy="78" r="2"/></g>

        <path d="M52 194H428" stroke="#465144"/>
        <g fill="#171c18" stroke="#465144"><rect x="28" y="184" width="96" height="22"/><rect x="148" y="184" width="96" height="22"/><rect x="268" y="184" width="80" height="22"/><rect x="372" y="184" width="80" height="22"/></g>
        <g fill="#a4aaa0" font-family="monospace" font-size="7"><text x="42" y="198">VUE.JS UI</text><text x="158" y="198">FLASK + RAG</text><text x="276" y="198">NOSQL</text><text x="381" y="198">GCP / DOCKER</text></g>
        <path d="M124 195H148M244 195H268M348 195H372" stroke="#d2ed78" stroke-dasharray="2 3"/>
        </g>
      </svg>
    )}
    {visual === 'vision' && (
      <svg viewBox="0 0 480 180" fill="none">
        <rect x="96" y="10" width="288" height="160" fill="#171c18" stroke="#465144"/>
        <g stroke="#8faaa0" stroke-opacity=".18"><path d="M96 50H384M96 90H384M96 130H384M156 10V170M216 10V170M276 10V170M336 10V170"/></g>
        <ellipse cx="240" cy="92" rx="79" ry="47" stroke="#8faaa0" stroke-dasharray="3 4"/><ellipse cx="240" cy="92" rx="52" ry="30" stroke="#d2ed78" stroke-opacity=".8"/><ellipse cx="240" cy="92" rx="24" ry="14" fill="#d2ed78" fill-opacity=".12" stroke="#d2ed78"/>
        <path d="M161 92H319M240 45V139" stroke="#d6a778" stroke-opacity=".5" stroke-dasharray="3 4"/><circle cx="240" cy="92" r="3" fill="#d2ed78"/>
        <text x="113" y="28" fill="#a4aaa0" font-family="monospace" font-size="8">SEGMENTATION / CONCEPT</text>
      </svg>
    )}
    {visual === 'warehouse' && (
      <svg viewBox="0 0 480 180" fill="none">
        <g stroke="#8faaa0" stroke-opacity=".48"><path d="M110 48H185M295 48H370M110 90H185M295 90H370M110 132H185M295 132H370"/><path d="M240 64V116" stroke-dasharray="3 4"/></g>
        <g><rect x="33" y="32" width="77" height="32" fill="#171c18" stroke="#465144"/><rect x="33" y="74" width="77" height="32" fill="#171c18" stroke="#465144"/><rect x="33" y="116" width="77" height="32" fill="#171c18" stroke="#465144"/><rect x="185" y="32" width="110" height="116" fill="#20291e" stroke="#d2ed78"/><rect x="370" y="32" width="77" height="32" fill="#171c18" stroke="#465144"/><rect x="370" y="74" width="77" height="32" fill="#171c18" stroke="#465144"/><rect x="370" y="116" width="77" height="32" fill="#171c18" stroke="#465144"/></g>
        <g fill="#a4aaa0" font-family="monospace" font-size="8"><text x="51" y="52">LEGACY</text><text x="53" y="94">OBJECTS</text><text x="51" y="136">BATCH</text><text x="219" y="88" fill="#d2ed78">VALIDATE</text><text x="212" y="103" fill="#d2ed78">& TRANSFORM</text><text x="383" y="52">WAREHOUSE</text><text x="393" y="94">MODELS</text><text x="389" y="136">SERVING</text></g>
      </svg>
    )}
    {visual === 'neuro' && (
      <svg viewBox="0 0 480 220" fill="none">
        <text x="18" y="22" fill="#a4aaa0" font-family="monospace" font-size="8" letter-spacing="1">fMRI / STATISTICAL RESPONSE MAPPING</text>

        <g transform="translate(-12 -4) scale(1.05)">
        <rect x="25" y="48" width="235" height="142" fill="#171c18" stroke="#303830"/>
        <text x="37" y="64" fill="#a4aaa0" font-family="monospace" font-size="7" letter-spacing=".7">FUNCTIONAL BRAIN IMAGE / CONCEPT</text>
        <path d="M142 83C125 70 96 75 82 92C69 108 76 130 91 140C103 149 112 163 132 166C144 168 153 160 161 151C172 161 185 168 198 163C215 156 215 142 229 132C245 121 246 99 230 86C215 73 189 74 174 85C163 93 155 94 142 83Z" fill="#20291e" stroke="#8faaa0" stroke-width="1.2"/>
        <path d="M158 91C154 108 155 132 161 151" stroke="#8faaa0" stroke-opacity=".55"/>
        <path d="M112 92C104 104 105 120 117 128M196 91C207 103 204 120 193 130M130 144C140 137 151 137 161 143M177 145C185 139 193 138 200 140" stroke="#8faaa0" stroke-opacity=".38"/>
        <ellipse cx="187" cy="111" rx="31" ry="23" fill="#d6a778" fill-opacity=".18"/>
        <ellipse cx="187" cy="111" rx="22" ry="16" fill="#d2ed78" fill-opacity=".18" stroke="#d2ed78" stroke-width="1.2"/>
        <circle cx="187" cy="111" r="4" fill="#d2ed78"/>
        <path d="M187 90V74H224" stroke="#d2ed78" stroke-width="1"/>
        <rect x="195" y="68" width="56" height="15" fill="#20291e" stroke="#465144"/>
        <text x="200" y="78" fill="#d2ed78" font-family="monospace" font-size="6">HOTSPOT</text>
        <g fill="#a4aaa0" font-family="monospace" font-size="6"><text x="37" y="179">MODEL-ESTIMATED ASSOCIATION</text></g>

        <rect x="274" y="48" width="181" height="65" fill="#171c18" stroke="#465144"/>
        <text x="286" y="63" fill="#a4aaa0" font-family="monospace" font-size="7" letter-spacing=".6">VOXEL-WISE RESPONSE</text>
        <path d="M287 99H443M287 80H443" stroke="#8faaa0" stroke-opacity=".18"/>
        <path d="M289 96L303 92L315 94L329 85L344 90L357 72L370 81L383 66L397 76L412 59L426 69L441 56" stroke="#d2ed78" stroke-width="1.5"/>
        <circle cx="383" cy="66" r="3" fill="#d2ed78"/><circle cx="412" cy="59" r="3" fill="#d6a778"/>
        <text x="287" y="107" fill="#727a70" font-family="monospace" font-size="6">fMRI SIGNAL / MODEL FIT</text>

        <rect x="274" y="123" width="181" height="67" fill="#171c18" stroke="#465144"/>
        <text x="286" y="138" fill="#a4aaa0" font-family="monospace" font-size="7" letter-spacing=".6">STATISTICAL INFERENCE</text>
        <rect x="286" y="147" width="70" height="29" fill="#20291e" stroke="#465144"/><rect x="365" y="147" width="78" height="29" fill="#20291e" stroke="#d2ed78" stroke-opacity=".7"/>
        <text x="295" y="159" fill="#a4aaa0" font-family="monospace" font-size="6">FEATURES</text><text x="295" y="169" fill="#f0efe8" font-family="monospace" font-size="7">50+ TB</text>
        <text x="372" y="159" fill="#a4aaa0" font-family="monospace" font-size="6">PREDICTED</text><text x="372" y="169" fill="#d2ed78" font-family="monospace" font-size="7">78% ACC.</text>
        <path d="M356 161H365" stroke="#d2ed78"/><path d="M360 158L364 161L360 164" stroke="#d2ed78"/>

        <text x="25" y="202" fill="#727a70" font-family="monospace" font-size="6">fMRI + CLINICAL DATA → MODEL → ASSOCIATED BRAIN REGION</text>
        <text x="374" y="202" fill="#d6a778" font-family="monospace" font-size="6">ASSOCIATION ≠ CAUSATION</text>
        </g>
      </svg>
    )}
    {visual === 'network' && (
      <svg viewBox="0 0 480 180" fill="none">
        <g stroke="#8faaa0" stroke-opacity=".38"><path d="M92 90L160 42L214 69L260 32L322 67L390 46M92 90L157 133L214 69L265 130L322 67L386 128M160 42L157 133M260 32L265 130M322 67L386 128M214 69L265 130"/></g>
        <g fill="#171c18" stroke="#8faaa0"><circle cx="92" cy="90" r="8"/><circle cx="160" cy="42" r="7"/><circle cx="157" cy="133" r="7"/><circle cx="214" cy="69" r="11" stroke="#d2ed78"/><circle cx="260" cy="32" r="7"/><circle cx="265" cy="130" r="9" stroke="#d6a778"/><circle cx="322" cy="67" r="9"/><circle cx="390" cy="46" r="7"/><circle cx="386" cy="128" r="7"/></g>
        <circle cx="214" cy="69" r="3" fill="#d2ed78"/><circle cx="265" cy="130" r="3" fill="#d6a778"/>
        <text x="174" y="163" fill="#a4aaa0" font-family="monospace" font-size="8">13K+ NODES / RELATIONSHIP SIGNALS</text>
      </svg>
    )}
  </div>
  <div class="ph-bottomline"><span>{label}</span></div>
</div>
